# Analytics. Both optional: leave either blank and no script is loaded and no
# event is sent. Set them in Netlify under Site settings, Environment variables.
#
# Plausible
#   VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
#   VITE_ANALYTICS_SITE=wandrnusa.com
#
# Umami
#   VITE_ANALYTICS_SRC=https://your-umami-host/script.js
#   VITE_ANALYTICS_SITE=00000000-0000-0000-0000-000000000000
#
# Events sent: "WhatsApp click" (props: src, placement, trip) and
# "Journey view" (props: trip, slug).
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_SITE=
